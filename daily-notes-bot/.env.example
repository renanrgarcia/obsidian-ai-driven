# Create the bot in Telegram with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=replace-me
# This is your personal Telegram numeric user id, not the bot id.
ALLOWED_USER_ID=123456789
OBSIDIAN_VAULT_PATH=/mnt/c/Users/your-user/Documents/ObsidianVault
DAILY_NOTES_DIR=5.Daily Notes
CAPTURE_LOG_FILENAME=capture-log.md
TIMEZONE=America/Sao_Paulo
# Generate this in Google AI Studio if you want Gemini transcription.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
